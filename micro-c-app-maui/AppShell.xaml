<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="micro_c_app_maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:micro_c_app_maui.Views"
    xmlns:reference="clr-namespace:micro_c_app_maui.Views.Reference"
    Title="Micro C App">

    <TabBar>
        <ShellContent
            Title="Search"
            ContentTemplate="{DataTemplate views:SearchPage}"
            Route="SearchPage" />
        <ShellContent
            Title="Quote"
            ContentTemplate="{DataTemplate views:QuotePage}"
            Route="QuotePage" />
        <ShellContent
            Title="PC Build"
            ContentTemplate="{DataTemplate views:BuildPage}"
            Route="BuildPage" />
        <ShellContent
            Title="References"
            ContentTemplate="{DataTemplate reference:ReferenceIndexPage}"
            Route="ReferenceIndexPage" />
        <ShellContent
            Title="Reminders"
            ContentTemplate="{DataTemplate views:RemindersPage}"
            Route="RemindersPage" />
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:AppSettingsPage}"
            Route="AppSettingsPage" />
    </TabBar>

</Shell>
