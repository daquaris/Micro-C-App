<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:micro_c_app_maui.ViewModels"
             x:Class="micro_c_app_maui.Views.BuildPage"
             Title="{Binding Title}"
             x:Name="page">

    <ContentPage.BindingContext>
        <vm:BuildPageViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*,Auto" Padding="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,8">
            <Label Grid.Column="0" Text="{Binding Subtotal, StringFormat='Subtotal: ${0:0.00}'}" />
            <Label Grid.Column="1" Text="{Binding TaxedTotal, StringFormat='Total (w/ tax): ${0:0.00}'}" FontAttributes="Bold" HorizontalTextAlignment="End" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Components}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="6*,2*" Padding="0,8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.ComponentSelectClicked, Source={x:Reference page}}" CommandParameter="{Binding}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding ComponentLabel}" MaxLines="2" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Item.SKU, StringFormat='SKU {0}'}" FontSize="Small" Opacity="0.7"
                                   IsVisible="{Binding Item, Converter={StaticResource NullBoolConverter}}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Item.Price, StringFormat='${0:0.00}'}" VerticalTextAlignment="Center" HorizontalTextAlignment="End"
                               IsVisible="{Binding Item, Converter={StaticResource NullBoolConverter}}" />
                        <BoxView Grid.Column="0" Grid.ColumnSpan="2" HeightRequest="1" Color="Gray" Opacity="0.3" VerticalOptions="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="Reset Build" Command="{Binding Reset}" Margin="0,8,0,0" HorizontalOptions="Start" />
    </Grid>
</ContentPage>
