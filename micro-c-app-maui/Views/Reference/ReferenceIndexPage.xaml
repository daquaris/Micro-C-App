<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:micro_c_app_maui.ViewModels.Reference"
             x:Class="micro_c_app_maui.Views.Reference.ReferenceIndexPage"
             Title="{Binding Title}"
             x:Name="page">

    <ContentPage.BindingContext>
        <vm:ReferenceIndexPageViewModel />
    </ContentPage.BindingContext>

    <CollectionView ItemsSource="{Binding Nodes}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid Padding="15,14">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.SelectedCommand, Source={x:Reference page}}" CommandParameter="{Binding}" />
                    </Grid.GestureRecognizers>
                    <Label Text="{Binding Name}" FontSize="Medium" />
                    <BoxView HeightRequest="1" Color="Gray" Opacity="0.3" VerticalOptions="End" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
