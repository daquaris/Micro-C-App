<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:micro_c_app_maui.ViewModels"
             x:Class="micro_c_app_maui.Views.SearchResultsPage"
             Title="{Binding Title}"
             x:Name="page">

    <ContentPage.BindingContext>
        <vm:SearchResultsPageViewModel />
    </ContentPage.BindingContext>

    <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="6*,3*,2*" Padding="10,8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.SelectItem, Source={x:Reference page}}" CommandParameter="{Binding}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{Binding Name}" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Brand}" FontSize="Small" Opacity="0.7" />
                        <Label Text="{Binding SKU, StringFormat='SKU {0}'}" FontSize="Small" Opacity="0.7" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding Price, StringFormat='${0:0.00}'}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="{Binding Stock}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
