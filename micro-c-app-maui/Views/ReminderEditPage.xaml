<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:micro_c_app_maui.ViewModels"
             x:Class="micro_c_app_maui.Views.ReminderEditPage"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="15" Spacing="12">
        <Label Text="{Binding Reminder.Name}" FontSize="Title" />
        <Label Text="{Binding Reminder.SKU, StringFormat='SKU {0}'}" Opacity="0.7" />

        <Label Text="Note" FontAttributes="Bold" Margin="0,10,0,0" />
        <Editor Text="{Binding Message}" Placeholder="Why are you watching this item?" MinimumHeightRequest="100" AutoSize="TextChanges" />

        <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
            <Button Text="Save" Command="{Binding Save}" />
            <Button Text="Cancel" Command="{Binding Cancel}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
