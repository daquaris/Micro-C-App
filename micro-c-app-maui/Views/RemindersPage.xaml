<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:micro_c_app_maui.ViewModels"
             x:Class="micro_c_app_maui.Views.RemindersPage"
             Title="{Binding Title}"
             x:Name="page">

    <ContentPage.BindingContext>
        <vm:RemindersPageViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*,Auto" Padding="10">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Reminders}">
            <CollectionView.EmptyView>
                <Label Text="No reminders yet. Search an item and tap &quot;Add Reminder&quot; to get notified when it's back in stock." HorizontalOptions="Center" VerticalOptions="Center" Margin="20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="6*,Auto,Auto" Padding="0,8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.Edit, Source={x:Reference page}}" CommandParameter="{Binding}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Name}" MaxLines="2" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding SKU, StringFormat='SKU {0}'}" FontSize="Small" Opacity="0.7" />
                            <Label Text="{Binding Message}" FontSize="Small" Opacity="0.7" IsVisible="{Binding Message, Converter={StaticResource NullBoolConverter}}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="Restocked!" TextColor="Green" FontAttributes="Bold" VerticalOptions="Center"
                               IsVisible="{Binding Notified}" />
                        <Button Grid.Column="2" Text="&#xf2ed;" FontFamily="FontAwesomeSolid" WidthRequest="44"
                                Command="{Binding BindingContext.Delete, Source={x:Reference page}}" CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="Check All" Command="{Binding CheckAll}" Margin="0,8,0,0" HorizontalOptions="Start" />
    </Grid>
</ContentPage>
