<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:micro_c_app_maui.ViewModels"
             xmlns:views="clr-namespace:micro_c_app_maui.Views"
             x:Class="micro_c_app_maui.Views.SearchPage"
             Title="{Binding Title}"
             x:Name="page">

    <ContentPage.BindingContext>
        <vm:SearchViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*,Auto" Padding="10">
        <Frame Grid.Row="0" IsVisible="{Binding HintVisible}" BorderColor="DarkGray" BackgroundColor="#33808080" Padding="10" Margin="0,0,0,5">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding HintText}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="&#xf00d;" FontFamily="FontAwesomeSolid" WidthRequest="44"
                        Command="{Binding DismissHint}" />
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1" IsVisible="{Binding Item, Converter={StaticResource NullBoolConverter}}">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding Item.Name}" FontSize="Title" />
                <Label Text="{Binding Item.Brand}" />
                <Label Text="{Binding Item.SKU, StringFormat='SKU: {0}'}" />
                <Label Text="{Binding Item.Specs[Mfr Part#], StringFormat='Mfr Part#: {0}'}" />
                <Label Text="{Binding Item.Specs[UPC], StringFormat='UPC: {0}'}" />
                <Label Text="{Binding Item.Price, StringFormat='Price: ${0:0.00}'}" />
                <Label Text="{Binding Item.Stock, StringFormat='Stock: {0}'}" />
                <Button Text="Open on microcenter.com" Command="{Binding GoToWebpage}" HorizontalOptions="Start" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" IsVisible="{Binding Item, Converter={StaticResource NullBoolConverter}, ConverterParameter=true}"
              RowDefinitions="Auto,*">
            <Label Grid.Row="0" Text="Search a SKU/UPC, scan a barcode, or browse a category:"
                   Margin="0,0,0,8" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid HeightRequest="70" Padding="6" ColumnDefinitions="Auto,*">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SearchCategoryCommand, Source={x:Reference page}}" CommandParameter="{Binding}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="{Binding Icon}" FontFamily="FontAwesomeSolid" FontSize="Large"
                                   VerticalTextAlignment="Center" WidthRequest="44" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="{Binding Name}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
            <Button Grid.Column="0" Text="&#xf015;" FontFamily="FontAwesomeSolid" WidthRequest="50"
                    Command="{Binding PopAll}" />
            <Button Grid.Column="1" Text="&#xf060;" FontFamily="FontAwesomeSolid" WidthRequest="50"
                    Command="{Binding PopItem}" />
            <views:SearchView Grid.Column="2" x:Name="searchView" />
        </Grid>
    </Grid>
</ContentPage>
