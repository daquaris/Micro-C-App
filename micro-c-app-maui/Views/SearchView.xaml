<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="micro_c_app_maui.Views.SearchView"
             x:Name="root">
    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
        <Entry x:Name="searchEntry" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Placeholder="SKU, UPC, or search text"
               Completed="OnSubmitClicked" />
        <Button Grid.Row="1" Grid.Column="1" Text="Search"
                Clicked="OnSubmitClicked" Margin="0,4,4,0" />
        <Button Grid.Row="1" Grid.Column="2" Text="Scan"
                Clicked="OnScanClicked" Margin="0,4,0,0" />
    </Grid>
</ContentView>
