<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:micro_c_app_maui.ViewModels"
             x:Class="micro_c_app_maui.Views.AppSettingsPage"
             Title="{Binding Title}">

    <ContentPage.BindingContext>
        <vm:SettingsPageViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Store" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding StoreNames}" SelectedItem="{Binding SelectedStoreName}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Theme" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding Vibrate}" />
                <Label Text="Vibrate on scan" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding AnalyticsEnabled}" />
                <Label Text="Share anonymous usage analytics" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
                <Button Text="Save" Command="{Binding Save}" />
                <Button Text="Cancel" Command="{Binding Cancel}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
